{
	"name": "@bro-code/build",
	"description": "ESBuild utilities for Bro Code.",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc",
		"clean": "rimraf dist .turbo"
	},
	"dependencies": {
		"zod": "^3.25.61"
	},
	"devDependencies": {
		"@bro-code/config-eslint": "workspace:^",
		"@bro-code/config-typescript": "workspace:^",
		"@types/node": "20.19.43",
		"vitest": "4.1.9"
	}
}
